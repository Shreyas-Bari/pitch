# ============================================
# PITCH — .gitignore
# ============================================

# Dependencies
node_modules/

# Environment variables & local environments
.env
.env.local
.env.*.local
.env*.local
*.env
!*.env.example

# Generated local secrets & credentials
secrets/
local-secrets/
*.secret
*.secrets
secrets.*
*.local.json

# Private keys & certificates
*.pem
*.key
*.pkcs12
*.pfx
*.cer
*.crt
id_rsa*
id_ed25519*

# JWT secrets & refresh tokens
jwt-secret*
*.jwt*
*token*.json
*token*.secret
tokens/
refresh-tokens/

# Cloudinary credentials
*cloudinary*.json
*cloudinary*.secret*
cloudinary_credentials*

# MongoDB data & database dumps
data/
data/db/
mongo-data/
dump/
*.mongo

# Build output
dist/
build/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Coverage & test output
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local reference / scratch
.project-ideas/

# Uploaded files (local dev)
uploads/
backend/storage/
storage/
