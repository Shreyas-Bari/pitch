# ============================================
# PITCH — .gitignore
# ============================================

# Dependencies
node_modules/

# Environment variables (secrets)
.env
.env.local
.env.*.local

# Build output
dist/
build/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Coverage & test output
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local reference / scratch
.project-ideas/

# Uploaded files (local dev)
uploads/
backend/storage/
storage/
