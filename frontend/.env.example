# ============================================
# PITCH Frontend — Environment Configuration Template
# ============================================
# Copy this file to .env for local development

# Base API URL: In dev, /api/v1 is proxied by Vite to http://localhost:5000/api/v1
# In production, set to your backend deployment domain (e.g. https://pitch-api.onrender.com/api/v1)
VITE_API_BASE_URL=/api/v1

# Realtime Socket.IO Server URL
VITE_SOCKET_URL=http://localhost:5000

# Application Identity
VITE_APP_NAME=PITCH
VITE_APP_TAGLINE=Where Brands Meet Campus Communities
